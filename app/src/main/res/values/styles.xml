<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#BFC1C5</item>
        <item name="android:windowBackground">#070809</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#070809</item>
        <item name="android:statusBarColor">#070809</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
    <style name="FlatButton">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:textColor">#D0D1D4</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">11dp</item>
        <item name="android:paddingRight">11dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="FlatButton.Accent">
        <item name="android:background">@drawable/button_accent</item>
        <item name="android:textColor">#111214</item>
    </style>
</resources>
