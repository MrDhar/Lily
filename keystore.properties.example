# Copy this file to keystore.properties (same folder as settings.gradle.kts)
# and fill in your real values. keystore.properties is git-ignored and must
# never be committed — see .gitignore.
#
# If you don't have a release keystore yet, create one with:
#   keytool -genkeypair -v -keystore projectlily-release.jks -alias projectlily -keyalg RSA -keysize 2048 -validity 10000

storeFile=/absolute/path/to/projectlily-release.jks
storePassword=changeme
keyAlias=projectlily
keyPassword=changeme
